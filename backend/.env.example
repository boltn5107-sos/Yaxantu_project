APP_NAME="Yaxantu"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Base de donnees ---
# Dev : MariaDB/MySQL (XAMPP). Production cible : PostgreSQL.
# DB_CONNECTION=pgsql
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=yaxantu
DB_USERNAME=yaxantu
DB_PASSWORD=

# --- Session / clients SPA ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost
SESSION_SECURE_COOKIE=false

FRONTEND_URL=http://localhost:3000

# Domaines autorises a utiliser l'authentification Sanctum par cookie (SPA)
# En prod (domaine unique) : app.yaxantu.com,api.yaxantu.com
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# --- Redis (a activer quand les services locaux seront disponibles) ---
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@yaxantu.local"
MAIL_FROM_NAME="${APP_NAME}"

# Stockage objet S3-compatible
FILESYSTEM_DISK_S3_AWS_ACCESS_KEY_ID=
FILESYSTEM_DISK_S3_AWS_SECRET_ACCESS_KEY=
FILESYSTEM_DISK_S3_AWS_DEFAULT_REGION=us-east-1
FILESYSTEM_DISK_S3_AWS_BUCKET=
FILESYSTEM_DISK_S3_AWS_USE_PATH_STYLE_ENDPOINT=false
FILESYSTEM_DISK_S3_URL=

VITE_APP_NAME="${APP_NAME}"